{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/propriedade/casa-beira-mar-tatajuba",
      "destination": "/propriedades",
      "permanent": false
    },
    {
      "source": "/:lang(en|es)/propriedade/casa-beira-mar-tatajuba",
      "destination": "/:lang/propriedades",
      "permanent": false
    },
    {
      "source": "/propriedade/casa-2-chales-serrote-jericoacoara",
      "destination": "/propriedade/casa-2-chales-serrote-jericoacoara-dolores",
      "permanent": true
    },
    {
      "source": "/:lang(en|es)/propriedade/casa-2-chales-serrote-jericoacoara",
      "destination": "/:lang/propriedade/casa-2-chales-serrote-jericoacoara-dolores",
      "permanent": true
    },
    {
      "source": "/propriedade/terreno-terreno-acarau-castelhano-simi",
      "destination": "/propriedade/terreno-acarau-castelhano-simi",
      "permanent": true
    },
    {
      "source": "/propriedade/villa-condudu-3",
      "destination": "/propriedade/villa-conduru-3",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets|favicon\\.ico|api|bitupita|advogados|parceiros|founders|aboutme|llms\\.txt|robots\\.txt)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*\\.(png|jpg|jpeg|gif|webp|svg|avif|ico|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
